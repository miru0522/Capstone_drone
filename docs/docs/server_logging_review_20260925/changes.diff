+    assert actual["result"]["confidence"] == round(binary[0] if expected == 0 else binary[1] * sub[expected-1], 4)
+    logs = records(capsys)
+    assert any(r["stage"] == "videomae_subclass" and r["event"] == "completed" for r in logs)
