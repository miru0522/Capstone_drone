"""
telemetry_sender.py  (★★★ 2026-08-18 스펙 전면 재작성 ★★★)

★★★ 구조 변경 (반드시 숙지) ★★★
  구버전: HTTP POST https://.../telemetry (REST)
  신버전: STOMP SEND /app/telemetry
  → REST 엔드포인트 자체가 서버에서 완전히 삭제됨(2026-08-17).
    이 파일을 구버전 그대로 쓰면 아무 효과 없이 계속 실패한다.

필드명 변경: sysid -> droneId (MAVLink sysid는 1~255 정수인데
  우리 값은 "DR-01" 같은 문자열이라 표준 용어 오용이었음, 정정됨)

status 필드 신규 필수: IDLE/PATROLLING/PAUSED/RETURNING/LANDING
  명령이 아니라 "실제 상태"를 보내야 함(정지지시 받았어도 실제로
  아직 안 멈췄으면 이전 상태 유지). command_receiver.py가
  /tmp/drone_status_state.json에 기록해두는 상태를 읽어와 반영.
  (진짜 정확하려면 MAVLink armed+비행모드를 직접 매핑해야 하나,
  1단계로는 command_receiver.py의 액션 처리 결과를 그대로 신뢰함 -
  향후 telemetry.flight_mode() 스트림으로 이원화 검증 권장)

currentAction 필드 선택: 명령 수행 중 상태, 완료시 null.
  PATROL_COMPLETE/RETURN_COMPLETE도 이 필드로 통지(자동착륙 폐지에 따라
  드론이 스스로 알려야 하는 값들) - 단, 완주/도착 감지 로직은
  아직 waypoint_mission.py쪽에 없어 1단계에서는 상태공유파일 값만
  그대로 전달(향후 보강 필요, G절 참고 문서에 기재).

연결 방식: command_receiver.py와 동일 원리(SockJS 제거, /ws 직결,
  몽키패치로 URL 고정). 별도의 독립 STOMP 연결을 맺는다(같은 커넥션을
  프로세스 간 공유할 수 없으므로 별도 연결이 정상적인 설계).

OFFLINE 상태는 보고하지 않는다(서버가 10초 무신호시 자체 판정).
"""

import os
import json
import time
import asyncio
import logging
import threading
from urllib.parse import urlparse
from typing import Optional

import stomp
import websocket
from mavsdk import System

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
logger = logging.getLogger("telemetry_sender")

# ─── 서버/드론 식별 설정 ────────────────────────────────────────
DRONE_ID = os.environ.get("DRONE_SYSID", "DR-01")  # ★필드명 droneId로 전송 (기존 sysid에서 변경)
DEVICE_KEY = os.environ.get("DEVICE_KEY", "")

SERVER_URL = os.environ.get("SERVER_URL", "http://203.249.90.3:8031")
WS_ENDPOINT = "/ws"
TELEMETRY_DESTINATION = "/app/telemetry"  # STOMP SEND 목적지 (REST 대체)

SEND_INTERVAL_SEC = 1.0
RECONNECT_SLEEP_SEC = 5.0

STATUS_STATE_PATH = os.environ.get("STATUS_STATE_PATH", "/tmp/drone_status_state.json")

parsed = urlparse(SERVER_URL)
host = parsed.hostname
port = parsed.port or 80
ws_scheme = "wss" if parsed.scheme == "https" else "ws"
FORCE_WS_URI = f"{ws_scheme}://{host}:{port}{WS_ENDPOINT}"

# --- 몽키패치 (command_receiver.py와 동일 원리, 별도 프로세스라 각자 적용 필요) ---
_original_create_connection = websocket.create_connection

def _patched_create_connection(url, *args, **kwargs):
    logger.info(f"[STOMP-Patch] Overriding URL: {url} -> {FORCE_WS_URI}")
    if kwargs.get('sslopt') is None:
        kwargs['sslopt'] = {}
    import ssl as _ssl
    kwargs['sslopt']['cert_reqs'] = _ssl.CERT_NONE
    return _original_create_connection(FORCE_WS_URI, *args, **kwargs)

websocket.create_connection = _patched_create_connection


def read_status_state() -> dict:
    """command_receiver.py가 기록해두는 상태 공유 파일을 읽는다."""
    try:
        with open(STATUS_STATE_PATH, "r") as f:
            return json.load(f)
    except Exception:
        return {"status": "IDLE", "currentAction": None}


class TelemetrySender:
    def __init__(self):
        self.system: Optional[System] = None
        self.stomp_conn: Optional[stomp.WSStompConnection] = None
        self.state = {
            "is_connected": False,
            "lat": 0.0,
            "lon": 0.0,
            "alt": 0.0,
            "batt_percent": 0.0,
            "batt_volt": 0.0,
        }
        self._tasks = []
        self.running = False

    # ─── MAVSDK (드론 상태 수집) ────────────────────────────────

    async def connect_drone(self) -> bool:
        try:
            self.system = System(mavsdk_server_address="localhost", port=50051)
            logger.info("공유 mavsdk_server(localhost:50051)에 연결 시도")
            await asyncio.wait_for(self.system.connect(), timeout=10.0)
            return True
        except Exception as e:
            logger.error(f"❌ 드론 연결 실패: {e}")
            return False

    async def connect_drone_with_retry(self):
        while not await self.connect_drone():
            logger.info(f"⏳ {RECONNECT_SLEEP_SEC}초 후 재시도...")
            await asyncio.sleep(RECONNECT_SLEEP_SEC)
        logger.info("✅ 드론 연결 성공")

    async def watch_connection(self):
        try:
            async for state in self.system.core.connection_state():
                self.state["is_connected"] = state.is_connected
                if state.is_connected:
                    logger.info("✅ 픽스호크 연결 확인 (Heartbeat 수신 중)")
                else:
                    logger.warning("❌ 픽스호크 연결 끊김 (Heartbeat 미수신)")
        except Exception as e:
            logger.error(f"연결 모니터링 오류: {e}")

    async def watch_battery(self):
        try:
            async for battery in self.system.telemetry.battery():
                pct = battery.remaining_percent
                if pct <= 1.0:
                    pct *= 100.0
                self.state["batt_percent"] = round(pct, 1)
                self.state["batt_volt"] = round(battery.voltage_v, 2)
        except Exception as e:
            logger.debug(f"배터리 스트림 오류: {e}")

    async def watch_position(self):
        try:
            async for position in self.system.telemetry.position():
                self.state["lat"] = round(position.latitude_deg, 6)
                self.state["lon"] = round(position.longitude_deg, 6)
                self.state["alt"] = round(position.absolute_altitude_m, 2)
        except Exception as e:
            logger.debug(f"GPS 스트림 오류: {e}")

    # ─── STOMP (텔레메트리 발행) ────────────────────────────────

    def connect_stomp(self):
        """동기 STOMP 연결 (command_receiver.py와 별개 독립 연결)."""
        while True:
            try:
                logger.info(f"[STOMP] Connecting to {host}:{port} (forced URL: {FORCE_WS_URI}) ...")
                conn = stomp.WSStompConnection([(host, port)])

                connect_headers = {}
                if DEVICE_KEY:
                    connect_headers["X-Device-Key"] = DEVICE_KEY

                conn.connect(wait=True, headers=connect_headers)
                logger.info("[STOMP] Telemetry connection established!")
                self.stomp_conn = conn
                return
            except Exception as e:
                logger.error(f"[STOMP] 텔레메트리 연결 오류: {e}")
                time.sleep(RECONNECT_SLEEP_SEC)

    def _send_telemetry(self, payload: dict) -> bool:
        try:
            if self.stomp_conn is None or not self.stomp_conn.is_connected():
                logger.warning("STOMP 연결 끊김 - 재연결 시도")
                self.connect_stomp()
            self.stomp_conn.send(
                destination=TELEMETRY_DESTINATION,
                body=json.dumps(payload),
                content_type="application/json",
            )
            return True
        except Exception as e:
            logger.warning(f"⚠️ 텔레메트리 전송 실패: {e}")
            return False

    async def telemetry_loop(self):
        # 2026-08-25: 대기 상태 로그를 매초 찍으면 용량만 차지하므로
        # 30초에 한 번만 남긴다 (대기->정상 전환시는 즉시 로그).
        last_wait_log_time = 0.0
        was_waiting = False

        while self.running:
            await asyncio.sleep(SEND_INTERVAL_SEC)

            if not self.state["is_connected"]:
                now = time.time()
                if not was_waiting or now - last_wait_log_time >= 30.0:
                    logger.info("[하드웨어 연결 대기] Heartbeat 신호를 기다리는 중...")
                    last_wait_log_time = now
                was_waiting = True
                continue

            if self.state["batt_volt"] <= 0.0:
                now = time.time()
                if not was_waiting or now - last_wait_log_time >= 30.0:
                    logger.info("[파라미터 대기] 연결되었으나 데이터 없음 (SR0_EXT_STAT, SR0_POSITION 확인 필요)")
                    last_wait_log_time = now
                was_waiting = True
                continue

            if was_waiting:
                logger.info("대기 해제 - 정상 텔레메트리 전송 재개")
                was_waiting = False

            status_info = read_status_state()
            payload = {
                "droneId": DRONE_ID,
                "status": status_info.get("status", "IDLE"),
                "currentAction": status_info.get("currentAction"),
                "gps": {
                    "lat_deg": self.state["lat"],
                    "lon_deg": self.state["lon"],
                    "abs_alt_m": self.state["alt"],
                },
                "battery": {"remaining_percent": self.state["batt_percent"]},
            }

            ok = await asyncio.get_event_loop().run_in_executor(None, self._send_telemetry, payload)
            # 매초 정상 전송 로그는 용량만 차지하므로 실패시에만 남긴다.
            if not ok:
                logger.warning(
                    f"텔레메트리 전송 실패 droneId={payload['droneId']} "
                    f"status={payload['status']} currentAction={payload['currentAction']}"
                )

    async def run(self):
        self.running = True
        await self.connect_drone_with_retry()

        # STOMP는 동기 라이브러리 -> 별도 스레드에서 연결
        stomp_thread = threading.Thread(target=self.connect_stomp, daemon=True)
        stomp_thread.start()
        stomp_thread.join(timeout=15.0)

        self._tasks = [
            asyncio.create_task(self.watch_connection()),
            asyncio.create_task(self.watch_battery()),
            asyncio.create_task(self.watch_position()),
            asyncio.create_task(self.telemetry_loop()),
        ]
        logger.info(f"텔레메트리 전송 시작 (주기 {SEND_INTERVAL_SEC}s → STOMP {TELEMETRY_DESTINATION})")
        await asyncio.gather(*self._tasks)

    def stop(self):
        self.running = False
        for t in self._tasks:
            t.cancel()


async def main():
    sender = TelemetrySender()
    try:
        await sender.run()
    except KeyboardInterrupt:
        logger.info("🛑 종료")
        sender.stop()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("🛑 종료")
